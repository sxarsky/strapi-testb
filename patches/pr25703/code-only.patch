+      query: ({ model, ...params }) => ({
+        url: `/i18n/content-manager/get-fill-from-locale/${model}`,
+        config: { params },
+      }),
+    }),
+  }),
+});
+
+export const { useGetFillFromLocaleDataQuery, useLazyGetFillFromLocaleDataQuery } =
+  fillFromLocaleApi;
